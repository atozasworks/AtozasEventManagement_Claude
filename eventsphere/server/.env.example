# Copy this file to .env (same folder) and adjust values. Never commit .env.

PORT=5000
BRAND_NAME=EventSphere

# Local MongoDB (no login):
MONGO_URI=mongodb://127.0.0.1:27017/eventsphere
# Server with login:
# MONGO_URI=mongodb://USER:PASSWORD@HOST:27017/eventsphere?authSource=admin

# Change this to a long random string before deploying anywhere.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Continue with Google. Create a Web application OAuth client in Google Cloud
# Console (APIs & Services -> Credentials). Authorized JavaScript origins must
# include CLIENT_URL (for example http://localhost:5173). Paste the client id here.
GOOGLE_CLIENT_ID=

# Public address of the web app. Used for CORS and for the links inside emails
# (verify email, reset password, join online).
CLIENT_URL=http://localhost:5173

# Platform fee charged on paid tickets (percent).
PLATFORM_FEE_PERCENT=2.5

# ---------------- Payments ----------------
# simulated = approves instantly (testing) | razorpay = real gateway
PAYMENT_MODE=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------- Email ----------------
# Any SMTP provider works (Amazon SES, Brevo, SendGrid, Zoho Mail, Gmail app password).
# Leave SMTP_HOST blank while developing: emails are then saved as .eml files in
# server/.outbox and printed in the server console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="EventSphere <tickets@your-domain.com>"

# Reminder emails/WhatsApp 24 hours and 1 hour before each event (true/false).
REMINDERS_ENABLED=true

# ---------------- WhatsApp ----------------
# Leave blank to log WhatsApp messages to the console instead of sending.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
